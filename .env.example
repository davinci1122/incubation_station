# キー名のみ。実際の値はコミットしない。
# Web（GitHub Pages）に秘密情報は置かない。下の2つは公開前提の値で、
# GitHub の Repository variables に設定する。
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
NEXT_PUBLIC_GAS_SCRIPT_ID=

# Worker（Cloud Run / Secret Manager）
GAS_HMAC_KEY=
DRIVE_OAUTH_CLIENT_ID=
DRIVE_OAUTH_CLIENT_SECRET=
DRIVE_REFRESH_TOKEN=
DRIVE_ROOT_FOLDER_ID=
CAPTURE_TIMEOUT_MS=240000

# GAS（Script Properties に設定。ファイルには書かない）
# HMAC_KEY / SPREADSHEET_ID / DRIVE_ROOT_FOLDER_ID / ALLOWED_EMAIL / ALERT_EMAIL

# AIのAPIキーは使わない。取得処理はAIを呼ばず、タグ整理はスプレッドシート上で行う。
